# Reference data — never commit (huge, licensed, or per-run).
# The folder itself ships (default annotation-dataset location); its contents
# never do.
references/*
!references/README.md
*.vep_cache/
*.bw
*.bigwig

# User-licensed OMIM flat files — never redistribute
mim2gene.txt
mimTitles.txt
genemap2.txt
morbidmap.txt

# ClinVar downloads (fetched per-run)
clinvar_*.vcf.gz
clinvar_*.vcf.gz.tbi
clinvar_*_pathogenic.tsv

# Pipeline outputs
results/
*.vep.vcf
*.vep.vcf.gz
*.vep.vcf.gz.tbi
*_summary.html
*_warnings.txt

# Large / binary reference files that may land in the tree
*.fa.gz
*.fa.gz.fai
*.fa.gz.gzi
*.tsv.gz
*.tsv.gz.tbi
*.sql

# Local overrides
config/*.local.yaml

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# OS
.DS_Store
.Rhistory

# test scratch (regenerated by test_dry_run.sh)
test/fixtures/
test/out/

# Software updates (in-app updater and release build artifacts)
.wsl-origin
webui/.dependencies-updated
webui/.build-required
config/annotation.config.yaml.new
release-manifest.txt
dist/
